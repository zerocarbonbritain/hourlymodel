    "industry.other_heat_TWhy": {
        "type": "statistic",
        "units": "TWh/yr",
        "values": {
            "total": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (heat)" ], "column": "Total"},
            "elec": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (heat)" ], "column": "Electricity"},
            "fe": {"ref": "industry.other_heat_fuel_efficiency"},
            "ee": {"ref": "industry.other_heat_elec_efficiency"}
        },
        "formula": "(elec * ee + (total - elec) * fe) / 100 * 0.01163",
        "round": 1,
