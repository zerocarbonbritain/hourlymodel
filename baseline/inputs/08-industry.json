        "values": {
            "fuel": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "Other - solid fuel"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "Other - total"},
            "unknown_elec": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (other)" ], "column": "Electricity"}
        },
        "formula": "fuel / (total + unknown_elec) * 100",
        "round": 1
    },
    "industry.other_non_heat_fixed_elec_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "gas": {"ref": "industry.other_non_heat_fixed_CH4_prc"},
            "oil": {"ref": "industry.other_non_heat_fixed_liquid_prc"},
            "coal": {"ref": "industry.other_non_heat_fixed_coal_prc"}
        },
        "formula": "100 - gas - oil - coal",
        "round": 1,
        "note": "Electricity takes the remainder so the rounded shares sum to 100. Unrounded it is electricity / total."
    },
