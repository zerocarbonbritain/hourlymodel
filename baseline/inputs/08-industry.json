    "industry.high_temp_process_TWhy": {
        "type": "statistic",
        "units": "TWh/yr",
        "values": {
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - total"}
        },
        "formula": "total * 0.01163",
        "round": 1,
        "note": "ECUK U4 total industries, ktoe. 1 ktoe = 0.01163 TWh."
    },
    "industry.high_temp_process_fixed_CH4_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "fuel": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - natural gas"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - total"}
        },
        "formula": "fuel / total * 100",
        "round": 1
    },
    "industry.high_temp_process_fixed_liquid_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "fuel": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - oil"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - total"}
        },
        "formula": "fuel / total * 100",
        "round": 1
    },
    "industry.high_temp_process_fixed_coal_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "fuel": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - solid fuel"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - total"}
        },
        "formula": "fuel / total * 100",
        "round": 1
    },
    "industry.high_temp_process_fixed_elec_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "gas": {"ref": "industry.high_temp_process_fixed_CH4_prc"},
            "oil": {"ref": "industry.high_temp_process_fixed_liquid_prc"},
            "coal": {"ref": "industry.high_temp_process_fixed_coal_prc"}
        },
        "formula": "100 - gas - oil - coal",
        "round": 1,
        "note": "Electricity takes the remainder so the rounded shares sum to 100. Unrounded it is electricity / total."
    },
    "industry.high_temp_process_fixed_biomass_prc": {
        "type": "assumption",
        "units": "%",
        "value": 0,
        "note": "U4 has no bioenergy column."
    },
    "industry.high_temp_process_DSR_CH4_prc": {
