{
    "industry.high_temp_process_fuel_efficiency": {
        "type": "assumption",
        "units": "%",
        "value": 60,
        "note": "Furnaces and kilns. Agora Industry (2024) table 14 gives 30 to 80% furnace efficiency. The value only sets the level of useful heat; baseline fuel use is unchanged."
    },
    "industry.high_temp_process_elec_efficiency": {
        "type": "assumption",
        "units": "%",
        "value": 75,
        "note": "Electric furnaces need about 80% of the final energy of fuel fired furnaces for the same output: JRC-IDEES 2021 useful to final energy ratios for glass melting, foundries, heat treatment and ceramic kilns. 60 / 0.8 = 75."
    },
    "industry.low_temp_process_fuel_efficiency": {
        "type": "assumption",
        "units": "%",
        "value": 80,
        "note": "Steam and hot water boilers including distribution losses. Agora Industry (2024) table 14 gives 89 to 97% net for the boiler alone; ECUK is on a gross basis."
    },
    "industry.low_temp_process_elec_efficiency": {
        "type": "assumption",
        "units": "%",
        "value": 100,
        "note": "Existing electric low temperature heat is mostly resistive. JRC-IDEES 2021 rates electric heat at about 1.25 times fuel in the same process. 80 x 1.25 = 100."
    },
    "industry.dry_sep_fuel_efficiency": {
        "type": "assumption",
        "units": "%",
        "value": 65,
        "note": "Fuel fired dryers. No device level source found, so this is an estimate. The value only sets the level of useful heat; baseline fuel use is unchanged."
    },
    "industry.dry_sep_elec_efficiency": {
        "type": "assumption",
        "units": "%",
        "value": 83,
        "note": "Electric drying needs about 78% of the final energy of fuel fired drying: JRC-IDEES 2021 useful to final energy ratios for food, wood and other drying. 65 / 0.78 = 83."
    },
    "industry.other_heat_fuel_efficiency": {
        "type": "assumption",
        "units": "%",
        "value": 80,
        "note": "Heat sold and bioenergy boilers. Taken as equal to low temperature process heat."
    },
    "industry.other_heat_elec_efficiency": {
        "type": "assumption",
        "units": "%",
        "value": 100,
        "note": "Taken as equal to low temperature process heat."
    },
    "industry.high_temp_process_TWhy": {
        "type": "statistic",
        "units": "TWh/yr",
        "values": {
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - total"},
            "elec": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - electricity"},
            "fe": {"ref": "industry.high_temp_process_fuel_efficiency"},
            "ee": {"ref": "industry.high_temp_process_elec_efficiency"}
        },
        "formula": "(elec * ee + (total - elec) * fe) / 100 * 0.01163",
        "round": 1,
        "note": "Useful heat. ECUK U4 total industries final energy, ktoe, times the conversion efficiency of each fuel. 1 ktoe = 0.01163 TWh."
    },
    "industry.high_temp_process_fixed_CH4_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "fuel": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - natural gas"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - total"},
            "elec": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - electricity"},
            "fe": {"ref": "industry.high_temp_process_fuel_efficiency"},
            "ee": {"ref": "industry.high_temp_process_elec_efficiency"}
        },
        "formula": "fuel * fe / (elec * ee + (total - elec) * fe) * 100",
        "round": 1,
        "note": "Share of useful heat."
    },
    "industry.high_temp_process_fixed_liquid_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "fuel": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - oil"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - total"},
            "elec": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - electricity"},
            "fe": {"ref": "industry.high_temp_process_fuel_efficiency"},
            "ee": {"ref": "industry.high_temp_process_elec_efficiency"}
        },
        "formula": "fuel * fe / (elec * ee + (total - elec) * fe) * 100",
        "round": 1,
        "note": "Share of useful heat."
    },
    "industry.high_temp_process_fixed_coal_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "fuel": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - solid fuel"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - total"},
            "elec": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "High temperature process - electricity"},
            "fe": {"ref": "industry.high_temp_process_fuel_efficiency"},
            "ee": {"ref": "industry.high_temp_process_elec_efficiency"}
        },
        "formula": "fuel * fe / (elec * ee + (total - elec) * fe) * 100",
        "round": 1,
        "note": "Share of useful heat."
    },
    "industry.high_temp_process_fixed_elec_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "gas": {"ref": "industry.high_temp_process_fixed_CH4_prc"},
            "oil": {"ref": "industry.high_temp_process_fixed_liquid_prc"},
            "coal": {"ref": "industry.high_temp_process_fixed_coal_prc"}
        },
        "formula": "100 - gas - oil - coal",
        "round": 1,
        "note": "Electricity takes the remainder so the rounded shares sum to 100. Unrounded it is elec * ee / (elec * ee + (total - elec) * fe)."
    },
    "industry.high_temp_process_fixed_biomass_prc": {
        "type": "assumption",
        "units": "%",
        "value": 0,
        "note": "U4 has no bioenergy column."
    },
    "industry.high_temp_process_DSR_CH4_prc": {
