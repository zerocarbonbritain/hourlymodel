    "industry.refinery_electric_TWhy": {
        "type": "statistic",
        "units": "TWh/yr",
        "values": {
            "eiu": {"source": "dukes_5.1", "sheet": "5.1", "block": "Category", "row": [ "Energy industry use" ], "column": "{year}"},
            "generation": {"source": "dukes_5.1", "sheet": "5.1", "block": "Category", "row": [ "Electricity generation" ], "column": "{year}"},
            "storage": {"source": "dukes_5.1", "sheet": "5.1", "block": "Category", "row": [ "Energy storage" ], "column": "{year}"}
        },
        "formula": "(eiu - generation - storage) / 1000",
        "round": 1,
        "note": "DUKES 5.1 energy industry use of electricity, excluding generation own use (in electricity_own_use_prc) and storage losses. Covers refineries, oil and gas extraction, coal, blast furnaces and other. GWh to TWh."
    },
    "industry.other_non_heat_TWhy": {
        "type": "statistic",
        "units": "TWh/yr",
        "values": {
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "Other - total"},
            "unknown_elec": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (other)" ], "column": "Electricity"}
        },
        "formula": "(total + unknown_elec) * 0.01163",
        "round": 1,
        "note": "ECUK U4 \"Other\" end use plus the electricity in the U2 industry \"Unknown (other)\" row. The other fuels in that row are carried in fossil_fuels."
    },
    "industry.other_non_heat_fixed_CH4_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "fuel": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "Other - natural gas"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U4", "block": "{year}", "row": [ "Total industries" ], "column": "Other - total"},
            "unknown_elec": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (other)" ], "column": "Electricity"}
        },
        "formula": "fuel / (total + unknown_elec) * 100",
