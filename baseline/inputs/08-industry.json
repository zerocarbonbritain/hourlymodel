    },
    "industry.other_heat_fixed_elec_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "elec": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (heat)" ], "column": "Electricity"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (heat)" ], "column": "Total"},
            "fe": {"ref": "industry.other_heat_fuel_efficiency"},
            "ee": {"ref": "industry.other_heat_elec_efficiency"}
        },
        "formula": "elec * ee / (elec * ee + (total - elec) * fe) * 100",
        "round": 1
    },
    "industry.other_heat_fixed_CH4_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "gas": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (heat)" ], "column": "Natural gas"},
            "heat": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (heat)" ], "column": "Heat"},
            "total": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (heat)" ], "column": "Total"},
            "elec": {"source": "ecuk_end_use", "sheet": "Table U2", "block": "All sectors detailed consumption", "row": [ "{year}", "Industry", "Unknown (heat)" ], "column": "Electricity"},
            "fe": {"ref": "industry.other_heat_fuel_efficiency"},
            "ee": {"ref": "industry.other_heat_elec_efficiency"}
        },
        "formula": "(gas + heat) * fe / (elec * ee + (total - elec) * fe) * 100",
        "round": 1,
        "note": "Share of useful heat. Heat sold is mapped to methane, as most heat networks are gas fired."
    },
    "industry.other_heat_fixed_biomass_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "gas": {"ref": "industry.other_heat_fixed_CH4_prc"},
            "elec": {"ref": "industry.other_heat_fixed_elec_prc"}
        },
        "formula": "100 - gas - elec",
        "round": 1,
        "note": "Remainder, so shares sum to 100. In 2024 the remainder is all bioenergy and waste. Oil or solid fuel in this row would also land here, since the baseline has no other_heat liquid or coal fields."
    },
