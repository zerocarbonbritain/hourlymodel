{
    "land_model.uk_area_kha": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "uaa": {
                "source": "defra_land_use",
                "sheet": "Land_use",
                "block": "Land use on agricultural holdings",
                "row": [
                    "Utilised agricultural area (UAA)"
                ],
                "column": "{year}"
            },
            "share": {
                "source": "defra_land_use",
                "sheet": "Land_use",
                "block": "Land use on agricultural holdings",
                "row": [
                    "UAA as a proportion of total UK area"
                ],
                "column": "{year}"
            }
        },
        "formula": "uaa / share / 1000",
        "round": 0,
        "note": "UK area implied by Defra's utilised agricultural area and its share of the total."
    },
    "_land.broadleaf_kha": {
        "type": "intermediate",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "w": {
                "value": 1710,
                "cite": "Forest Research, Forestry Statistics 2025, Table 1.1, woodland area at 31 March 2025"
            }
        },
        "formula": "w",
        "round": 0,
        "note": "Broadleaf woodland, UK."
    },
    "_land.conifer_kha": {
        "type": "intermediate",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "w": {
                "value": 1576,
                "cite": "Forest Research, Forestry Statistics 2025, Table 1.1, woodland area at 31 March 2025"
            }
        },
        "formula": "w",
        "round": 0,
        "note": "Conifer woodland, UK."
    },
    "land_use.existing_natural_broadleaf_woodland": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "b": {
                "ref": "_land.broadleaf_kha"
            }
        },
        "formula": "b * 139 / 1386",
        "round": 0,
        "note": "Forest Research does not split natural and productive woodland, so the ZCB land use model proportions are kept (natural broadleaf 139 of 1,386 kha, natural conifer 151 of 1,508 kha)."
    },
    "land_use.existing_productive_broadleaf_woodland": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "b": {
                "ref": "_land.broadleaf_kha"
            }
        },
        "formula": "b * 1247 / 1386",
        "round": 0,
        "note": "Forest Research does not split natural and productive woodland, so the ZCB land use model proportions are kept (natural broadleaf 139 of 1,386 kha, natural conifer 151 of 1,508 kha)."
    },
    "land_use.existing_natural_coniferous_woodland": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "c": {
                "ref": "_land.conifer_kha"
            }
        },
        "formula": "c * 151 / 1508",
        "round": 0,
        "note": "Forest Research does not split natural and productive woodland, so the ZCB land use model proportions are kept (natural broadleaf 139 of 1,386 kha, natural conifer 151 of 1,508 kha)."
    },
    "land_use.existing_productive_coniferous_woodland": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "c": {
                "ref": "_land.conifer_kha"
            }
        },
        "formula": "c * 1357 / 1508",
        "round": 0,
        "note": "Forest Research does not split natural and productive woodland, so the ZCB land use model proportions are kept (natural broadleaf 139 of 1,386 kha, natural conifer 151 of 1,508 kha)."
    },
    "land_use.new_natural_broadleaf_woodland": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 0,
        "note": "All woodland in the baseline year is existing woodland. New woodland is a scenario choice."
    },
    "land_use.new_natural_coniferous_woodland": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 0,
        "note": "All woodland in the baseline year is existing woodland. New woodland is a scenario choice."
    },
    "land_use.new_productive_broadleaf_woodland": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 0,
        "note": "All woodland in the baseline year is existing woodland. New woodland is a scenario choice."
    },
    "land_use.new_productive_coniferous_woodland": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 0,
        "note": "All woodland in the baseline year is existing woodland. New woodland is a scenario choice."
    },
    "land_use.short_rotation_forestry": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 0,
        "note": "Negligible area in the UK."
    },
    "land_use.annual_grass_hemp": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 0,
        "note": "Negligible area in the UK (a few kha licensed in England)."
    },
    "land_use.perrennial_grass_miscanthus": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 0,
        "note": "Miscanthus for liquid fuel is derived by the model from synthetic fuel biomass, which is 0 in the baseline. Miscanthus grown for heat and power is in short rotation coppice."
    },
    "land_use.rotational_grass_ryegrass": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 0,
        "note": "Ryegrass for biogas is derived by the model. Maize for anaerobic digestion is in food crops (see the note there)."
    },
    "land_use.intensive_and_rough_grazing": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "permanent": {
                "source": "defra_land_use",
                "sheet": "Land_use",
                "block": "Land use on agricultural holdings",
                "row": [
                    "Total permanent grassland"
                ],
                "column": "{year}"
            },
            "common": {
                "source": "defra_land_use",
                "sheet": "Land_use",
                "block": "Land use on agricultural holdings",
                "row": [
                    "Common rough grazing"
                ],
                "column": "{year}"
            }
        },
        "formula": "(permanent + common) / 1000",
        "round": 0,
        "note": "Permanent grassland, sole right rough grazing and common rough grazing. Temporary grass is in feed crops."
    },
    "land_use.feed_crops_for_livestock": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "f": {
                "source": "defra_land_feed",
                "sheet": "Land_use_area_summary",
                "block": "Land used to feed livestock",
                "row": [
                    "To feed livestock(2)"
                ],
                "column": "{year}",
                "after": "Croppable area"
            }
        },
        "formula": "f / 1000",
        "round": 0,
        "note": "Croppable land used to feed livestock, including temporary grass and stockfeeding crops."
    },
    "_land.energy_crops_kha": {
        "type": "intermediate",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "src": {
                "source": "defra_bioenergy_crops",
                "sheet": "1_1",
                "block": "1.1: Total area of crops grown",
                "row": [
                    "Short rotation coppice area (England only)"
                ],
                "column": "{year}"
            },
            "miscanthus": {
                "source": "defra_bioenergy_crops",
                "sheet": "1_1",
                "block": "1.1: Total area of crops grown",
                "row": [
                    "Miscanthus area (England only)"
                ],
                "column": "{year}"
            }
        },
        "formula": "(src + miscanthus) / 1000",
        "round": 1,
        "note": "Short rotation coppice and miscanthus, England only (Defra's last edition of the series, 2024). Wales and Scotland areas are small."
    },
    "land_use.food_crops": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "other": {
                "source": "defra_land_feed",
                "sheet": "Land_use_area_summary",
                "block": "Land used to feed livestock",
                "row": [
                    "For other uses"
                ],
                "column": "{year}",
                "after": "Croppable area"
            },
            "energy": {
                "ref": "_land.energy_crops_kha"
            }
        },
        "formula": "other / 1000 - energy",
        "round": 0,
        "note": "Croppable land not used for livestock: food and industrial crops, crops for biofuel and anaerobic digestion (about 130 kha in 2024) and uncropped arable land, less the energy crops counted as short rotation coppice."
    },
    "land_model.uk_crop_biomass_prc": {
        "type": "calibrated",
        "years": [
            2024
        ],
        "units": "%",
        "values": {
            "area": {
                "ref": "_land.energy_crops_kha"
            }
        },
        "target": "area",
        "model_output": "land_use.short_rotation_coppice",
        "round": 3,
        "note": "Share of direct use solid biomass grown on UK energy crops, set so the land the model derives for it equals the energy crop area. The rest is imported or comes from wastes and residues."
    },
    "land_use.semi_natural_grassland": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 155,
        "note": "ZCB land use model value. No cached source yet."
    },
    "land_use.coastal_and_freshwater": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 692,
        "note": "ZCB land use model value. No cached source yet."
    },
    "land_use.urban_areas": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "kha",
        "value": 1459,
        "note": "ZCB land use model value. No cached source yet."
    },
    "land_use.mountain_heath_and_bog": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kha",
        "values": {
            "area": {
                "ref": "land_model.uk_area_kha"
            },
            "b": {
                "ref": "_land.broadleaf_kha"
            },
            "c": {
                "ref": "_land.conifer_kha"
            },
            "grazing": {
                "ref": "land_use.intensive_and_rough_grazing"
            },
            "feed": {
                "ref": "land_use.feed_crops_for_livestock"
            },
            "food": {
                "ref": "land_use.food_crops"
            },
            "energy": {
                "ref": "_land.energy_crops_kha"
            },
            "semi": {
                "ref": "land_use.semi_natural_grassland"
            },
            "coastal": {
                "ref": "land_use.coastal_and_freshwater"
            },
            "urban": {
                "ref": "land_use.urban_areas"
            }
        },
        "formula": "area - (b + c + grazing + feed + food + energy + semi + coastal + urban)",
        "round": 0,
        "note": "The remainder of the UK area: mountain, heath and bog not grazed, plus other land on holdings such as farm buildings and tracks. It depends on the unsourced urban, coastal and semi natural areas."
    },
    "land_model.existing_woodland_tCO2_per_ha": {
        "type": "calibrated",
        "years": [
            2024
        ],
        "units": "tCO2/ha/yr",
        "values": {
            "forest": {
                "source": "ghg_by_source",
                "sheet": "UK_by_source",
                "sum": "Emissions (MtCO2e)",
                "where": {
                    "Year": "{year}",
                    "Territorial Emissions Statistics sector": "LULUCF",
                    "CRT category": "4A*"
                },
                "where_not": {
                    "CRT category": [
                        "*(III)*",
                        "*(IV)*"
                    ]
                }
            }
        },
        "target": "forest",
        "model_output": "emissions_balance.existing_woodland",
        "round": 3,
        "note": "Average net sequestration of existing woodland, set so it reproduces the inventory forest land sink (carbon stock change and drainage, excluding wildfires and N mineralisation, which are in other fields)."
    },
    "land_model.landfill_biochar_MtCO2": {
        "type": "assumption",
        "years": [
            2024
        ],
        "units": "MtCO2/yr",
        "value": 0,
        "note": "No biochar is made from landfill waste in the UK."
    }
}
