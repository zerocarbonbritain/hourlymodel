        "units": "MtCO2e",
        "values": {
            "all": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics sector": "Agriculture"}
            },
            "fuel_co2": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics subsector": "Agricultural combustion", "GHG grouped": "CO2"}
            }
