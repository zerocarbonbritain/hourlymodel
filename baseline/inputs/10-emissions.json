            "f29": {"ref": "emissions_balance.mechanical_biological_treatment"},
            "f30": {"ref": "emissions_balance.landfill_carbon_capture"}
        },
        "formula": "total - (f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12 + f13 + f14 + f15 + f16 + f17 + f18 + f19 + f20 + f21 + f22 + f23 + f24 + f25 + f26 + f27 + f28 + f29 + f30)",
        "round": 3,
        "note": "Territorial emissions the model must calculate itself: fuel combustion CO2, forest and harvested wood, and municipal solid waste CO2."
    },
    "co2_factors.gas": {
        "type": "statistic",
        "years": [2024],
        "units": "kgCO2/kWh",
        "values": {
            "f": {"source": "desnz_ghg_factors", "sheet": "Factors by Category", "sum": "GHG Conversion Factor 2024", "where": {"Scope": "Scope 1", "Level 1": "Fuels", "Level 3": "Natural gas (100% mineral blend)", "UOM": "kWh (Gross CV)", "GHG/Unit": "kg CO2e of CO2 per unit"}}
        },
        "formula": "f",
        "round": 5,
        "note": "DESNZ 2024 conversion factor, kgCO2 per kWh gross, CO2 only. Mineral natural gas, since biomethane is not in the fossil gas the model counts."
    },
    "co2_factors.coal": {
        "type": "statistic",
        "years": [2024],
        "units": "kgCO2/kWh",
        "values": {
            "f": {"source": "desnz_ghg_factors", "sheet": "Factors by Category", "sum": "GHG Conversion Factor 2024", "where": {"Scope": "Scope 1", "Level 1": "Fuels", "Level 3": "Coal (industrial)", "UOM": "kWh (Gross CV)", "GHG/Unit": "kg CO2e of CO2 per unit"}}
        },
        "formula": "f",
        "round": 5,
        "note": "DESNZ 2024 conversion factor, kgCO2 per kWh gross, CO2 only. Coal used outside power generation, mostly industrial."
    },
    "co2_factors.road_fuel": {
        "type": "statistic",
        "years": [2024],
        "units": "kgCO2/kWh",
        "values": {
            "diesel_f": {"source": "desnz_ghg_factors", "sheet": "Factors by Category", "sum": "GHG Conversion Factor 2024", "where": {"Scope": "Scope 1", "Level 1": "Fuels", "Level 3": "Diesel (100% mineral diesel)", "UOM": "kWh (Gross CV)", "GHG/Unit": "kg CO2e of CO2 per unit"}},
            "petrol_f": {"source": "desnz_ghg_factors", "sheet": "Factors by Category", "sum": "GHG Conversion Factor 2024", "where": {"Scope": "Scope 1", "Level 1": "Fuels", "Level 3": "Petrol (100% mineral petrol)", "UOM": "kWh (Gross CV)", "GHG/Unit": "kg CO2e of CO2 per unit"}},
            "diesel": {"source": "ecuk_consumption", "sheet": "Table C8", "block": "Road transport energy use by vehicle type", "row": ["{year-1}"], "column": "All - white diesel"},
            "petrol": {"source": "ecuk_consumption", "sheet": "Table C8", "block": "Road transport energy use by vehicle type", "row": ["{year-1}"], "column": "All - petrol"}
        },
        "formula": "(diesel * diesel_f + petrol * petrol_f) / (diesel + petrol)",
        "round": 5,
        "note": "DESNZ 2024 conversion factor, kgCO2 per kWh gross, CO2 only. Mineral diesel and petrol weighted by ECUK C8 road fuel use (the year before, as C8 runs a year behind). Also applied to rail and domestic shipping. The model separates biofuel."
    },
    "co2_factors.aviation": {
        "type": "statistic",
        "years": [2024],
        "units": "kgCO2/kWh",
        "values": {
