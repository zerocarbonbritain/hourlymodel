            "f14": {"ref": "emissions_balance.ammonia"},
            "f15": {"ref": "emissions_balance.bricks"},
            "f16": {"ref": "emissions_balance.other_process_emissions"},
            "f17": {"ref": "emissions_balance.agriculture_total"},
            "f18": {"ref": "emissions_balance.biomass_burning"},
            "f19": {"ref": "emissions_balance.land_remaining_and_converted_to_grassland"},
            "f20": {"ref": "emissions_balance.land_remaining_and_converted_to_cropland"},
            "f21": {"ref": "emissions_balance.land_remaining_and_converted_to_settlements"},
            "f22": {"ref": "emissions_balance.land_remaining_and_converted_to_wetlands"},
