    "_emissions.lulucf_left_to_land_use_model": {
        "type": "intermediate",
        "units": "MtCO2e",
        "values": {
            "lulucf": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics sector": "LULUCF"}
            },
            "f0": {"ref": "emissions_balance.biomass_burning"},
            "f1": {"ref": "emissions_balance.land_remaining_and_converted_to_grassland"},
            "f2": {"ref": "emissions_balance.land_remaining_and_converted_to_cropland"},
            "f3": {"ref": "emissions_balance.land_remaining_and_converted_to_settlements"},
            "f4": {"ref": "emissions_balance.land_remaining_and_converted_to_wetlands"},
            "f5": {"ref": "emissions_balance.land_use_n2o"}
        },
        "formula": "lulucf - (f0 + f1 + f2 + f3 + f4 + f5)",
        "round": 3,
        "note": "LULUCF not in emissions_balance: forest land carbon stock and drainage, and harvested wood products. Compare with the modelled forest sink plus harvested wood."
