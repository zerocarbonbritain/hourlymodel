            }
        },
        "formula": "a",
        "round": 3
    },
    "emissions_balance.other_process_emissions": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "all": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics subsector": "Industrial processes"}
            },
            "named": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Cement production", "Lime production", "Glass production", "Bricks production", "Fletton brick production", "Sinter production", "Iron and steel production processes", "Iron and steel - coke production fugitives", "Halocarbon production - F-gases", "Magnesium cover gas - F-gases", "Aluminium production - F-gases" ]}
            }
        },
        "formula": "all - named",
