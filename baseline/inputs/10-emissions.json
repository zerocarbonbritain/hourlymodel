    "emissions_balance.biomass_burning": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "a": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "CRT category": "4*(IV)*"}
            }
        },
        "formula": "a",
        "round": 3,
        "note": "LULUCF wildfires and controlled burning, CRT (IV) codes."
    },
    "emissions_balance.land_remaining_and_converted_to_grassland": {
