{
    "_emissions.territorial_total": {
        "type": "intermediate",
        "units": "MtCO2e",
        "values": {
            "total": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes"}
            }
        },
        "formula": "total",
        "round": 3,
        "note": "UK territorial total, excluding international aviation and shipping."
    },
    "_emissions.international_aviation_shipping": {
        "type": "intermediate",
        "units": "MtCO2e",
        "values": {
            "total": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "No", "Territorial Emissions Statistics sector": "International aviation and shipping"}
            }
        },
        "formula": "total",
        "round": 3
    },
    "_emissions.total_including_bunkers": {
        "type": "intermediate",
        "units": "MtCO2e",
        "values": {
            "territorial": {"ref": "_emissions.territorial_total"},
            "bunkers": {"ref": "_emissions.international_aviation_shipping"}
        },
        "formula": "territorial + bunkers",
        "round": 3,
        "note": "Compare with the model total emissions, which adds an aviation non CO2 uplift."
    },
    "emissions_balance.power_station": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "a": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics subsector": "Power stations", "GHG grouped": [ "CH4", "N2O", "HFCs", "PFCs", "SF6", "NF3" ]}
            }
        },
        "formula": "a",
        "round": 3,
        "note": "CH4 and N2O only. Fuel CO2 is calculated by the model. Non-biomass municipal solid waste CO2 (7.1 Mt in 2024) is also left out: DUKES 5.6 counts it under other thermal, which the baseline maps to coal backup."
    },
    "emissions_balance.manufacture_solid_fuels": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "coke": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": "Iron and steel - coke production"}
            },
            "ssf": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": "Coal mining and handling", "Source": [ "Solid smokeless fuel production", "Charcoal production" ]}
            }
        },
        "formula": "coke + ssf",
        "round": 3,
        "note": "Coke production, solid smokeless fuel and charcoal production, all gases. The model has no solid fuel transformation."
    },
    "emissions_balance.coal_mining_handling": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "all": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": "Coal mining and handling"}
            },
            "ssf": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": "Coal mining and handling", "Source": [ "Solid smokeless fuel production", "Charcoal production" ]}
            }
        },
        "formula": "all - ssf",
        "round": 3,
        "note": "Coal mining and handling, all gases, less solid fuel manufacture (counted in manufacture_solid_fuels)."
    },
    "emissions_balance.upstream_ch4_leakage": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "og_nonco2": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics subsector": "Oil and gas supply", "GHG grouped": [ "CH4", "N2O", "HFCs", "PFCs", "SF6", "NF3" ]}
            },
            "og_process_co2": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics subsector": "Oil and gas supply", "GHG grouped": "CO2", "Fuel group": "Other emissions"}
            },
            "fv_nonco2": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Gas - flaring", "Gas - venting", "Oil - flaring", "Oil - venting" ], "GHG grouped": [ "CH4", "N2O", "HFCs", "PFCs", "SF6", "NF3" ]}
            },
            "fv_process_co2": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Gas - flaring", "Gas - venting", "Oil - flaring", "Oil - venting" ], "GHG grouped": "CO2", "Fuel group": "Other emissions"}
            }
        },
        "formula": "og_nonco2 + og_process_co2 - fv_nonco2 - fv_process_co2",
        "round": 3,
        "note": "Oil and gas supply less flaring and venting: leakage, fugitives, process CO2, and CH4 and N2O from fuel combustion. Fuel CO2 is calculated by the model."
    },
    "emissions_balance.oil_and_gas_flaring_venting": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "fv": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Gas - flaring", "Gas - venting", "Oil - flaring", "Oil - venting" ]}
            }
        },
        "formula": "fv",
        "round": 3,
        "note": "Gas and oil flaring and venting, all gases."
    },
    "emissions_balance.refrigerants": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "fgas": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Commercial refrigeration - F-gases", "Industrial refrigeration - F-gases", "Residential refrigeration - F-gases", "Stationary air-conditioning and heat pumps - F-gases", "Mobile air-conditioning - F-gases", "Transport refrigeration - F-gases" ]}
            }
        },
        "formula": "fgas",
        "round": 3,
        "note": "Refrigeration, air conditioning and heat pump F-gases, including mobile and transport."
    },
    "emissions_balance.other_foams_solvents_aerosols": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "uses": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Foams - F-gases", "Firefighting - F-gases", "Anaesthetic use of N2O", "Electronics and other - F-gases", "Other product uses", "Lubricant use in industrial engines", "Accidental fires", "Halocarbon production - F-gases", "Magnesium cover gas - F-gases", "Aluminium production - F-gases" ]}
            },
            "combustion": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Commercial combustion", "Public sector combustion", "Other industrial combustion", "Industrial off-road mobile machinery", "Iron and steel production", "House and garden mobile machinery" ], "GHG grouped": [ "CH4", "N2O", "HFCs", "PFCs", "SF6", "NF3" ]}
            }
        },
        "formula": "uses + combustion",
        "round": 3,
        "note": "Product uses, F-gas production, industrial lubricants and accidental fires (all gases), plus CH4 and N2O from commercial, public and industrial combustion. Follows the 2018 workbook, where these were the business sector emissions other than fuel CO2 and refrigeration."
    },
    "emissions_balance.transport_ch4_and_n2o": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "nonco2": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics sector": "Domestic transport", "GHG grouped": [ "CH4", "N2O", "HFCs", "PFCs", "SF6", "NF3" ]}
            },
            "fgas": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Mobile air-conditioning - F-gases", "Transport refrigeration - F-gases" ]}
            },
            "non_energy": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Lubricant use in engines", "Urea use in transport" ]}
            }
        },
        "formula": "nonco2 - fgas + non_energy",
        "round": 3,
        "note": "Domestic transport CH4 and N2O, plus lubricant and urea CO2. Transport F-gases are in refrigerants."
    },
    "emissions_balance.domestic_combustion_ch4_and_n20": {
        "type": "statistic",
        "units": "MtCO2e",
        "values": {
            "a": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": "Residential combustion", "GHG grouped": [ "CH4", "N2O", "HFCs", "PFCs", "SF6", "NF3" ]}
            }
        },
        "formula": "a",
