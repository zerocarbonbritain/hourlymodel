            "a": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": { "Year": "{year}", "Included in UK territorial total": "Yes", "Territorial Emissions Statistics category": [ "Sinter production", "Iron and steel production processes", "Iron and steel - coke production fugitives" ]}
            }
        },
        "formula": "a",
