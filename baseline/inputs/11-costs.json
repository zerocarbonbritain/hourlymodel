        },
        "formula": "(typical - nil) / 3100 * 100",
        "round": 3,
        "note": "Ofgem default tariff cap, direct debit, mean of the four 2024 cap periods, before VAT. Supplier costs and margins per kWh."
    },
    "retail.electricity.supplier_gbp": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "£/yr",
        "values": {
