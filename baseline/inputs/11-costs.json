                "expect": {
                    "B8": "Other Payment Method",
                    "BL10": "Gas",
                    "BL45": "Total_GB average",
                    "CD30": "Jan 2024 - Mar 2024",
                    "CG30": "Oct 2024 - Dec 2024"
                }
            },
            "df": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
                "range": "CD31:CG31",
                "expect": {
                    "B8": "Other Payment Method",
                    "BL10": "Gas",
                    "BL31": "DF",
                    "CD30": "Jan 2024 - Mar 2024",
                    "CG30": "Oct 2024 - Dec 2024"
                }
            },
            "pc": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
                "range": "CD34:CG34",
                "expect": {
                    "B8": "Other Payment Method",
                    "BL10": "Gas",
                    "BL34": "PC",
                    "CD30": "Jan 2024 - Mar 2024",
                    "CG30": "Oct 2024 - Dec 2024"
                }
            },
            "nc": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
