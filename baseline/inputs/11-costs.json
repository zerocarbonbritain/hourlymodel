{
    "_retail.elec_supplier_typical_gbp": {
        "type": "intermediate",
        "years": [
            2024
        ],
        "units": "£/yr at 3,100 kWh",
        "values": {
            "total": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
                "range": "T45:W45",
                "expect": {
                    "B8": "Other Payment Method",
                    "B10": "Electricity: Single-Rate Metering Arrangement",
                    "B45": "Total_GB average",
                    "T30": "Jan 2024 - Mar 2024",
                    "W30": "Oct 2024 - Dec 2024"
                }
            },
            "df": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
                "range": "T31:W31",
                "expect": {
                    "B8": "Other Payment Method",
                    "B10": "Electricity: Single-Rate Metering Arrangement",
                    "B31": "DF",
                    "T30": "Jan 2024 - Mar 2024",
                    "W30": "Oct 2024 - Dec 2024"
                }
            },
            "cm": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
                "range": "T32:W32",
                "expect": {
                    "B8": "Other Payment Method",
                    "B10": "Electricity: Single-Rate Metering Arrangement",
                    "B32": "CM",
                    "T30": "Jan 2024 - Mar 2024",
                    "W30": "Oct 2024 - Dec 2024"
                }
            },
            "pc": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
                "range": "T34:W34",
                "expect": {
                    "B8": "Other Payment Method",
                    "B10": "Electricity: Single-Rate Metering Arrangement",
                    "B34": "PC",
                    "T30": "Jan 2024 - Mar 2024",
                    "W30": "Oct 2024 - Dec 2024"
                }
            },
            "nc": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
                "range": "T35:W35",
                "expect": {
                    "B8": "Other Payment Method",
                    "B10": "Electricity: Single-Rate Metering Arrangement",
                    "B35": "NC",
                    "T30": "Jan 2024 - Mar 2024",
                    "W30": "Oct 2024 - Dec 2024"
                }
            }
        },
        "formula": "total - df - cm - pc - nc",
        "round": 2,
        "note": "Supplier operating costs, smart metering, payment method, EBIT, headroom and adjustment allowances at the 3,100 kWh benchmark: total less wholesale (DF), capacity market (CM), policy (PC) and network (NC)."
    },
    "_retail.elec_supplier_nil_gbp": {
        "type": "intermediate",
        "years": [
            2024
        ],
        "units": "£/yr",
        "values": {
            "total": {
                "source": "ofgem_cap",
                "sheet": "1b Historical level tables",
                "range": "T27:W27",
                "expect": {
                    "B8": "Other Payment Method",
                    "B10": "Electricity: Single-Rate Metering Arrangement",
                    "B27": "Total_GB average",
