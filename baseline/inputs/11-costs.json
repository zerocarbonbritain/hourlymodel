    },
    "fuel_values.hydrogen_gbp_MWh": {
        "type": "assumption",
        "units": "£/MWh",
        "value": 0,
        "note": "The baseline burns fossil fuel, so the ZCB fuel values do not apply and hourly prices are not reported."
    },
    "fuel_values.methane_gbp_MWh": {
        "type": "assumption",
        "units": "£/MWh",
        "value": 0,
        "note": "The baseline burns fossil fuel, so the ZCB fuel values do not apply and hourly prices are not reported."
    },
    "retail.electricity.network_basis": {
        "type": "assumption",
        "value": "per_kWh",
        "note": "Baselines pay network charges at the observed per kWh rate. Scenarios can scale network cost with peak demand relative to the 2024 baseline."
    }
}
