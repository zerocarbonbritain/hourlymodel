    "retail.gas.households_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "meters": {
                "source": "desnz_subnational_gas",
                "sheet": "{year}",
                "block": "Subnational gas consumption, Great Britain",
                "row": [
                    "K03000001",
                    "Great Britain (inc unallocated)",
                    "All local authorities"
                ],
                "column": "Number of meters (thousands): Domestic"
            },
            "households": {
                "source": "ons_households",
                "sheet": "5",
                "block": "Number of households (thousands)",
                "row": [
                    "All households"
                ],
                "column": "{year} Estimate"
            }
        },
        "formula": "meters / households * 100",
        "round": 1,
        "note": "Domestic gas meters in Great Britain over UK households. Northern Ireland gas customers are not in the source, so the share is slightly low."
    },
