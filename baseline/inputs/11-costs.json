                "where": {
                    "Scope": "Scope 1",
                    "Level 1": "Fuels",
                    "Level 3": "Diesel (average biofuel blend)",
                    "UOM": "litres",
                    "GHG/Unit": "kg CO2e of CO2 per unit"
                }
            },
            "per_kWh": {
                "source": "desnz_ghg_factors",
                "sheet": "Factors by Category",
                "sum": "GHG Conversion Factor 2024",
                "where": {
                    "Scope": "Scope 1",
                    "Level 1": "Fuels",
                    "Level 3": "Diesel (average biofuel blend)",
                    "UOM": "kWh (Gross CV)",
                    "GHG/Unit": "kg CO2e of CO2 per unit"
