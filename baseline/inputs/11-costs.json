    },
    "retail.road_fuel.car_diesel_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "diesel": {
                "source": "ecuk_consumption",
                "sheet": "Table C8",
                "block": "Road transport energy use by vehicle type",
