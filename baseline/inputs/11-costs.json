            },
            "x": {
                "ref": "retail.electricity.network_existing_gbp_bn"
            },
            "e": {
                "source": "dukes_1.1",
                "sheet": "{year}",
                "block": "Aggregate energy commodity balance",
                "row": [
                    "Domestic"
                ],
                "column": "Electricity"
            }
        },
        "formula": "(p * e * 0.01163 * 0.01 + s * h * 1e-9) / x * 100",
        "round": 1,
        "note": "Domestic share of the 2024 network revenue: the Ofgem cap network rate on DUKES domestic electricity plus the cap network standing charge on every home."
    }
}
