    "retail.gas.households_prc": {
        "type": "statistic",
        "units": "%",
        "values": {
            "meters": {
                "source": "desnz_subnational_gas",
                "sheet": "{year}",
                "block": "Subnational gas consumption, Great Britain",
                "row": [
                    "K03000001",
                    "Great Britain (inc unallocated)",
                    "All local authorities"
                ],
                "column": "Number of meters (thousands): Domestic"
            },
            "households": {
                "source": "ons_households",
                "sheet": "5",
                "block": "Number of households (thousands)",
                "row": [
                    "All households"
                ],
                "column": "{year} Estimate"
            }
        },
        "formula": "meters / households * 100",
        "round": 1,
        "note": "Domestic gas meters in Great Britain over UK households. Northern Ireland gas customers are not in the source, so the share is slightly low."
    },
    "retail.vat_prc": {
        "type": "assumption",
        "units": "%",
        "value": 5,
        "note": "Reduced rate of VAT on domestic fuel and power."
    },
    "retail.road_fuel.petrol_p_litre": {
        "type": "statistic",
        "units": "p/litre",
        "values": {
            "p": {
                "source": "qep_4.1",
                "sheet": "4.1.2",
                "block": "Table 4.1.2 Typical retail prices",
                "row": [
                    "{year}"
                ],
                "column": "Motor spirit: Premium unleaded / ULSP (Pence per litre)"
            }
        },
        "formula": "p",
        "round": 2,
        "note": "Annual average pump price of unleaded petrol, including duty and VAT."
    },
    "retail.road_fuel.diesel_p_litre": {
        "type": "statistic",
        "units": "p/litre",
        "values": {
            "p": {
                "source": "qep_4.1",
                "sheet": "4.1.2",
                "block": "Table 4.1.2 Typical retail prices",
                "row": [
                    "{year}"
                ],
                "column": "Derv: Diesel / ULSD (Pence per litre)"
            }
        },
        "formula": "p",
        "round": 2,
        "note": "Annual average pump price of diesel, including duty and VAT."
    },
    "retail.road_fuel.petrol_kWh_per_litre": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kWh/litre",
        "values": {
            "per_litre": {
                "source": "desnz_ghg_factors",
                "sheet": "Factors by Category",
                "sum": "GHG Conversion Factor 2024",
                "where": {
                    "Scope": "Scope 1",
                    "Level 1": "Fuels",
                    "Level 3": "Petrol (average biofuel blend)",
                    "UOM": "litres",
                    "GHG/Unit": "kg CO2e of CO2 per unit"
                }
            },
            "per_kWh": {
                "source": "desnz_ghg_factors",
                "sheet": "Factors by Category",
                "sum": "GHG Conversion Factor 2024",
                "where": {
                    "Scope": "Scope 1",
                    "Level 1": "Fuels",
                    "Level 3": "Petrol (average biofuel blend)",
                    "UOM": "kWh (Gross CV)",
                    "GHG/Unit": "kg CO2e of CO2 per unit"
                }
            }
        },
        "formula": "per_litre / per_kWh",
        "round": 3,
        "note": "Energy per litre (gross) of pump petrol at the average biofuel blend, from the ratio of the DESNZ 2024 CO2 factors per litre and per kWh."
    },
    "retail.road_fuel.diesel_kWh_per_litre": {
        "type": "statistic",
        "years": [
            2024
        ],
        "units": "kWh/litre",
        "values": {
