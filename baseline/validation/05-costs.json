        "label": "Fossil reference, non-domestic gas including CCL",
        "units": "p/kWh",
        "observed": {
            "values": {
                "p": {"source": "qep_3.4.1", "sheet": "3.4.2 (Annual inc CCL)", "block": "Table 3.4.2", "row": ["{year}"], "column": "Gas: Average (Pence per kWh)"}
            },
            "formula": "p"
        },
        "model": {
            "values": {"a": "i.fossil_reference.non_domestic_gas.with_ccl_p_kWh"},
            "formula": "a"
        },
