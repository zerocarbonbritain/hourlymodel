{
    "costs.generation_resource": {
        "group": "Costs",
        "label": "Generation cost in the unit rate, build-up for every technology",
        "units": "p/kWh",
        "observed": {
            "values": {
                "df": {"source": "ofgem_cap", "sheet": "1b Historical level tables", "range": "T31:W31", "expect": {"B8": "Other Payment Method", "B10": "Electricity: Single-Rate Metering Arrangement", "B31": "DF", "T30": "Jan 2024 - Mar 2024", "W30": "Oct 2024 - Dec 2024"}},
                "cm": {"source": "ofgem_cap", "sheet": "1b Historical level tables", "range": "T32:W32", "expect": {"B8": "Other Payment Method", "B10": "Electricity: Single-Rate Metering Arrangement", "B32": "CM", "T30": "Jan 2024 - Mar 2024", "W30": "Oct 2024 - Dec 2024"}},
                "ro": {"source": "ofgem_cap", "sheet": "3d PC", "range": "AD53:AG53", "expect": {"C53": "RO", "AD50": "January 2024 - March 2024", "AG50": "October 2024 - December 2024"}},
                "fit": {"source": "ofgem_cap", "sheet": "3d PC", "range": "AD54:AG54", "expect": {"C54": "FiT", "AD50": "January 2024 - March 2024", "AG50": "October 2024 - December 2024"}}
            },
            "formula": "(df + cm) / 3100 * 100 + (ro + fit) / 10"
        },
        "model": {
            "values": {
                "a": "retail.electricity.resource_p_kWh"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "Ofgem cap wholesale (including CfD), capacity market, Renewables Obligation and Feed-in Tariff costs per kWh, mean of the four 2024 cap periods, against the build-up for every technology per kWh delivered (capital, O&M, fuel and carbon of every generator and store at new-build costs).",
        "issue": "The build-up is what the 2024 system would cost to build today. Consumers paid wholesale prices set by gas plant, support for older renewables and, in 2024, power bought forward in 2023. The 2024 prices check below rebuilds what was paid (open-items.md, Model).",
        "years": [2024]
    },
    "costs.generation_price": {
        "group": "Costs",
        "label": "Generation cost in the unit rate, 2024 prices",
        "units": "p/kWh",
        "observed": {
            "values": {
                "df": {"source": "ofgem_cap", "sheet": "1b Historical level tables", "range": "T31:W31", "expect": {"B8": "Other Payment Method", "B10": "Electricity: Single-Rate Metering Arrangement", "B31": "DF", "T30": "Jan 2024 - Mar 2024", "W30": "Oct 2024 - Dec 2024"}},
                "cm": {"source": "ofgem_cap", "sheet": "1b Historical level tables", "range": "T32:W32", "expect": {"B8": "Other Payment Method", "B10": "Electricity: Single-Rate Metering Arrangement", "B32": "CM", "T30": "Jan 2024 - Mar 2024", "W30": "Oct 2024 - Dec 2024"}},
                "ro": {"source": "ofgem_cap", "sheet": "3d PC", "range": "AD53:AG53", "expect": {"C53": "RO", "AD50": "January 2024 - March 2024", "AG50": "October 2024 - December 2024"}},
                "fit": {"source": "ofgem_cap", "sheet": "3d PC", "range": "AD54:AG54", "expect": {"C54": "FiT", "AD50": "January 2024 - March 2024", "AG50": "October 2024 - December 2024"}}
            },
            "formula": "(df + cm) / 3100 * 100 + (ro + fit) / 10"
        },
        "model": {
            "values": {
                "a": "retail.electricity.generation_cost_p_kWh",
                "b": "i.retail.electricity.wholesale_adjustment_p_kWh"
            },
            "formula": "a + b"
        },
        "tolerance": 0.05,
        "basis": "input",
        "note": "Modelled generation for each technology at its 2024 capture price plus RO, CfD, FiT and capacity market payments, per kWh delivered, plus the 2024 domestic wholesale adjustment (forward purchasing and the domestic profile). Prices are observed, volumes are modelled.",
        "years": [2024]
    },
    "costs.gas_build_up": {
        "group": "Costs",
        "label": "Gas generation, build-up against price paid",
        "units": "£/MWh",
        "observed": {
            "values": {
                "capture": {"value": 85.04, "cite": "Generation weighted mean of the LCCC intermittent market reference price (GB day ahead hourly, dp.lowcarboncontracts.uk resource d0e58993-d8b2-4ab5-90e0-518b1e7b2f1e) over 2024, weighted by Elexon FUELHH half hourly generation for CCGT (baseline/inputs/13-prices.json)"}
            },
            "formula": "capture"
        },
        "model": {
            "values": {
                "a": "generation_costs.by_tech.gas.lcoe"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "Build-up for gas generation (its share of backup turbine capacity at new-build cost, variable O&M, and 2024 fuel and carbon prices) against the 2024 day ahead capture price for gas. The 2024 baseline costs gas at the capture price.",
        "issue": "Fuel and carbon alone are about £93/MWh at the DUKES fleet efficiency, above the capture price, and turbine capacity at new-build cost adds about £37/MWh. The 2024 fleet is largely paid off and also earns capacity market and balancing payments (open-items.md, Model).",
        "years": [2024]
    },
    "costs.electricity_unit_rate": {
        "group": "Costs",
        "label": "Domestic electricity unit rate",
        "units": "p/kWh",
        "observed": {
            "values": {
                "u": {"source": "qep_2.2.4", "sheet": "2.2.4", "block": "Table 2.2.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average variable unit price (£/kWh)"}
            },
            "formula": "u * 100"
        },
        "model": {
            "values": {
                "a": "retail.electricity.unit_rate_p_kWh"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "DESNZ average variable unit price including VAT, all payment methods. The model adds network, social policy and supplier costs to the generation cost.",
        "issue": "By design. The model has no network standing charge: homes pay their share of the system network cost on the unit rate, which moves about 3.4 p/kWh (£116 a year before VAT) from the standing charge to the unit rate. The bill at 3,400 kWh is the like for like check (docs/cost-assumptions.md, network cost)."
    },
    "costs.electricity_standing": {
        "group": "Costs",
        "label": "Domestic electricity standing charge",
        "units": "£/yr",
        "observed": {
            "values": {
                "f": {"source": "qep_2.2.4", "sheet": "2.2.4", "block": "Table 2.2.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average fixed cost (£/year)"}
            },
            "formula": "f"
        },
        "model": {
            "values": {
                "a": "retail.electricity.standing_charge_gbp"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "input",
        "note": "Built from the Ofgem cap nil consumption allowances, including VAT.",
        "issue": "By design. The model's standing charge covers policy and supplier costs only. The network part, £116.23 before VAT in the 2024 cap, is on the unit rate. Without it the observed figure is about £83."
    },
    "costs.electricity_bill": {
        "group": "Costs",
        "label": "Domestic electricity bill at 3,400 kWh",
        "units": "£/yr",
        "observed": {
            "values": {
                "b": {"source": "qep_2.2.1", "sheet": "2.2.1", "block": "Average annual domestic Standard Electricity bills", "row": ["{year}"], "column": "Overall: All Tariffs (pounds)"}
            },
            "formula": "b"
        },
        "model": {
            "values": {
                "u": "retail.electricity.unit_rate_p_kWh",
                "s": "retail.electricity.standing_charge_gbp"
            },
            "formula": "u * 34 + s"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "DESNZ standard bill at 3,400 kWh a year."
    },
    "costs.gas_wholesale": {
        "group": "Costs",
        "label": "Wholesale gas cost in the domestic unit rate",
        "units": "p/kWh",
        "observed": {
            "values": {
                "df": {"source": "ofgem_cap", "sheet": "1b Historical level tables", "range": "CD31:CG31", "expect": {"B8": "Other Payment Method", "BL10": "Gas", "BL31": "DF", "CD30": "Jan 2024 - Mar 2024", "CG30": "Oct 2024 - Dec 2024"}}
            },
            "formula": "df / 12000 * 100"
        },
        "model": {
            "values": {
                "a": "retail.gas.wholesale_p_kWh"
            },
            "formula": "a"
        },
        "tolerance": 0.02,
        "basis": "input",
        "note": "Ofgem cap gas wholesale allowance against the model's domestic gas wholesale cost: the gas price paid by power producers (QEP 3.2.1) plus the 2024 domestic adjustment.",
        "years": [2024]
    },
    "costs.gas_unit_rate": {
        "group": "Costs",
        "label": "Domestic gas unit rate",
        "units": "p/kWh",
        "observed": {
            "values": {
                "u": {"source": "qep_2.3.4", "sheet": "2.3.4", "block": "Table 2.3.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average variable unit price (£/kWh)"}
            },
            "formula": "u * 100"
        },
        "model": {
            "values": {
                "a": "retail.gas.unit_rate_p_kWh"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "DESNZ average variable unit price including VAT."
    },
    "costs.gas_standing": {
        "group": "Costs",
        "label": "Domestic gas standing charge",
        "units": "£/yr",
        "observed": {
            "values": {
                "f": {"source": "qep_2.3.4", "sheet": "2.3.4", "block": "Table 2.3.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average fixed cost (£/year)"}
            },
            "formula": "f"
        },
        "model": {
            "values": {
                "a": "retail.gas.standing_charge_gbp"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "input"
    },
    "costs.gas_bill": {
        "group": "Costs",
        "label": "Domestic gas bill at 11,200 kWh",
        "units": "£/yr",
        "observed": {
            "values": {
                "b": {"source": "qep_2.3.1", "sheet": "2.3.1", "block": "Average annual domestic gas bills", "row": ["{year}"], "column": "Overall: All Tariffs (pounds)"}
            },
            "formula": "b"
        },
        "model": {
            "values": {
                "u": "retail.gas.unit_rate_p_kWh",
                "s": "retail.gas.standing_charge_gbp"
            },
            "formula": "u * 112 + s"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "DESNZ bill at 11,200 kWh a year."
    },
    "costs.electricity_spend": {
        "group": "Costs",
        "label": "Household electricity spend, DUKES use at QEP prices",
        "units": "£bn/yr",
        "observed": {
            "values": {
                "e": {"source": "dukes_1.1", "sheet": "{year}", "block": "Aggregate energy commodity balance", "row": ["Domestic"], "column": "Electricity"},
                "u": {"source": "qep_2.2.4", "sheet": "2.2.4", "block": "Table 2.2.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average variable unit price (£/kWh)"},
                "h": {"source": "ons_households", "sheet": "5", "block": "Number of households (thousands)", "row": ["All households"], "column": "{year} Estimate"},
                "f": {"source": "qep_2.2.4", "sheet": "2.2.4", "block": "Table 2.2.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average fixed cost (£/year)"}
            },
            "formula": "e * 0.01163 * u + h * 1000 * f / 1e9"
        },
        "model": {
            "values": {
                "a": "retail.electricity.household_spend_bn"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "Domestic electricity use times the average unit price, plus the average fixed cost for every household. Tests consumption and price together."
    },
    "costs.electricity_spend_ons": {
        "group": "Costs",
        "label": "Household electricity spend, ONS",
        "units": "£bn/yr",
        "observed": {
            "values": {
                "s": {"source": "qep_2.6.1", "sheet": "2.6.1", "block": "Table 2.6.1", "row": ["{year}"], "column": "Electricity (£ million)"}
            },
            "formula": "s / 1000"
        },
        "model": {
            "values": {
                "a": "retail.electricity.household_spend_bn"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "ONS consumer expenditure.",
        "issue": "ONS spend is about 13% below DUKES use at QEP prices for 2024, so the two observed series disagree (open-items.md, Observed data)."
    },
    "costs.gas_spend": {
        "group": "Costs",
        "label": "Household gas spend, DUKES use at QEP prices",
        "units": "£bn/yr",
        "observed": {
            "values": {
                "g": {"source": "dukes_1.1", "sheet": "{year}", "block": "Aggregate energy commodity balance", "row": ["Domestic"], "column": "Natural gas"},
                "u": {"source": "qep_2.3.4", "sheet": "2.3.4", "block": "Table 2.3.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average variable unit price (£/kWh)"},
                "f": {"source": "qep_2.3.4", "sheet": "2.3.4", "block": "Table 2.3.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average fixed cost (£/year)"},
                "meters": {"source": "desnz_subnational_gas", "sheet": "{year}", "block": "Subnational gas consumption, Great Britain", "row": ["K03000001", "Great Britain (inc unallocated)", "All local authorities"], "column": "Number of meters (thousands): Domestic"}
            },
            "formula": "g * 0.01163 * u + meters * 1000 * f / 1e9"
        },
        "model": {
            "values": {
                "a": "retail.gas.household_spend_bn"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "Domestic gas use times the average unit price, plus the fixed cost for every domestic gas meter in Great Britain.",
        "issue": "Domestic gas use is 10% below DUKES (see the domestic gas check)."
    },
    "costs.gas_spend_ons": {
        "group": "Costs",
        "label": "Household gas spend, ONS",
        "units": "£bn/yr",
        "observed": {
            "values": {
                "s": {"source": "qep_2.6.1", "sheet": "2.6.1", "block": "Table 2.6.1", "row": ["{year}"], "column": "Gas (£ million)"}
            },
            "formula": "s / 1000"
        },
        "model": {
            "values": {
                "a": "retail.gas.household_spend_bn"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "ONS consumer expenditure.",
        "issue": "ONS spend is about 25% below DUKES use at QEP prices for 2024, so the two observed series disagree (open-items.md, Observed data)."
    },
    "costs.vehicle_fuel_spend": {
        "group": "Costs",
        "label": "Household vehicle fuel spend",
        "units": "£bn/yr",
        "observed": {
            "values": {
                "s": {"source": "qep_2.6.1", "sheet": "2.6.1", "block": "Table 2.6.1", "row": ["{year}"], "column": "Vehicle Fuels and Lubricants (£ million)"}
            },
            "formula": "s / 1000"
        },
        "model": {
            "values": {
                "a": "retail.road_fuel.car_fuel_spend_bn"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "ONS household spend on vehicle fuels and lubricants against modelled car fuel at pump prices. Car fuel is calibrated to the ECUK car share of road fuel, which includes company cars that households do not pay for."
    },
    "costs.petrol_price": {
        "group": "Costs",
        "label": "Petrol pump price",
        "units": "p/litre",
        "observed": {
            "values": {
                "p": {"source": "qep_4.1", "sheet": "4.1.2", "block": "Table 4.1.2 Typical retail prices", "row": ["{year}"], "column": "Motor spirit: Premium unleaded / ULSP (Pence per litre)"}
            },
            "formula": "p"
        },
        "model": {
            "values": {
                "a": "i.retail.road_fuel.petrol_p_litre"
            },
            "formula": "a"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "Including duty and VAT."
    },
    "costs.diesel_price": {
        "group": "Costs",
        "label": "Diesel pump price",
        "units": "p/litre",
        "observed": {
            "values": {
                "p": {"source": "qep_4.1", "sheet": "4.1.2", "block": "Table 4.1.2 Typical retail prices", "row": ["{year}"], "column": "Derv: Diesel / ULSD (Pence per litre)"}
            },
            "formula": "p"
        },
        "model": {
            "values": {
                "a": "i.retail.road_fuel.diesel_p_litre"
            },
            "formula": "a"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "Including duty and VAT."
    },
    "costs.fossil_ref_petrol": {
        "group": "Costs",
        "label": "Fossil reference, petrol before tax",
        "units": "p/litre",
        "observed": {
            "values": {
                "p": {"source": "qep_4.1", "sheet": "4.1.2 (excl VAT)", "range": "W426:W426", "expect": {"A426": "2024", "W6": "Annual Average ULSP: Ex VAT & Duty\n(Pence per litre)"}}
            },
            "formula": "p"
        },
        "model": {
            "values": {"a": "fossil_reference.pump.petrol.before"},
            "formula": "a"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "Pump price less VAT and duty against the QEP annual average."
    },
    "costs.fossil_ref_diesel": {
        "group": "Costs",
        "label": "Fossil reference, diesel before tax",
        "units": "p/litre",
        "observed": {
            "values": {
                "p": {"source": "qep_4.1", "sheet": "4.1.2 (excl VAT)", "range": "U426:U426", "expect": {"A426": "2024", "U6": "Annual Average Derv: Ex VAT & Duty\n(Pence per litre)"}}
            },
            "formula": "p"
        },
        "model": {
            "values": {"a": "fossil_reference.pump.diesel.before"},
            "formula": "a"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "Pump price less VAT and duty against the QEP annual average."
    },
    "costs.fossil_ref_burning_oil": {
        "group": "Costs",
        "label": "Fossil reference, burning oil price",
        "units": "p/litre",
        "observed": {
            "values": {
                "p": {"source": "qep_4.1", "sheet": "4.1.2", "block": "Table 4.1.2 Typical retail prices", "row": ["{year}"], "column": "Standard grade burning oil (Pence per litre)"}
            },
            "formula": "p"
        },
        "model": {
            "values": {"a": "i.fossil_reference.burning_oil.p_litre"},
            "formula": "a"
        },
        "tolerance": 0.01,
