    "costs.fossil_ref_non_domestic_gas": {
        "group": "Costs",
        "label": "Fossil reference, non-domestic gas excluding CCL",
        "units": "p/kWh",
        "observed": {
            "values": {
                "p": {"source": "qep_3.4.1", "sheet": "3.4.1 (Annual excl CCL)", "block": "Table 3.4.1", "row": ["{year}"], "column": "Gas: Average (Pence per kWh)"}
            },
            "formula": "p"
        },
        "model": {
            "values": {"a": "i.fossil_reference.non_domestic_gas.p_kWh"},
            "formula": "a"
        },
