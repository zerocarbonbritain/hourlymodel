    },
    "costs.fossil_ref_gas_oil": {
        "group": "Costs",
        "label": "Fossil reference, gas oil price",
        "units": "p/litre",
        "observed": {
            "values": {
                "p": {"source": "qep_4.1", "sheet": "4.1.2", "block": "Table 4.1.2 Typical retail prices", "row": ["{year}"], "column": "Gas oil (Pence per litre)"}
            },
            "formula": "p"
        },
        "model": {
            "values": {"a": "i.fossil_reference.gas_oil.p_litre"},
            "formula": "a"
        },
        "tolerance": 0.01,
