    },
    "costs.fossil_ref_final_volume": {
        "group": "Costs",
        "label": "Fossil reference, final user volume against this run",
        "units": "ratio",
        "observed": {
            "values": {"one": {"value": 1, "cite": "The stored volume should equal the live baseline run"}},
            "formula": "one"
        },
        "model": {
            "values": {
                "stored": "fossil_reference.final.TWh",
                "liquid": "final_consumption.liquid",
                "shipping": "final_consumption.international_shipping",
                "gas": "final_consumption.gas",
                "coal": "fossil_fuels.coal",
                "coal_power": "fossil_fuels.coal_for_dispatchable",
                "scale": "GWh_to_TWhy"
            },
            "formula": "stored / ((liquid + shipping + gas + coal - coal_power) * scale)"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "Volumes in the reference are fixed. A failure means they need updating from baseline_2024."
    },
    "costs.fossil_ref_household_gas": {
        "group": "Costs",
        "label": "Fossil reference, household gas against the baseline bill",
        "units": "ratio",
        "observed": {
            "values": {"one": {"value": 1, "cite": "The reference should equal the baseline's household gas spend"}},
            "formula": "one"
        },
        "model": {
            "values": {
                "stored": "fossil_reference.rows.household_gas.after_bn",
                "spend": "retail.gas.household_spend_bn"
            },
            "formula": "stored / spend"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "Commodity to delivered in the reference against the retail gas calculation."
    },
    "costs.fossil_bill_final": {
        "group": "Costs",
        "label": "Fossil bill for this run against the 2024 reference",
        "units": "ratio",
        "observed": {
            "values": {"one": {"value": 1, "cite": "In the 2024 baseline, the scenario bill should equal the reference"}},
            "formula": "one"
        },
        "model": {
            "values": {
                "bill": "fossil_bill.final.after_bn",
                "reference": "fossil_reference.final.after_bn"
            },
            "formula": "bill / reference"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "The bill uses live volumes and the reference uses stored volumes, at the same prices."
    },
    "costs.consumer_electricity": {
        "group": "Costs",
        "label": "Electricity users' spend before VAT, DUKES use at QEP prices",
        "units": "£bn/yr",
        "observed": {
            "values": {
                "all": {"source": "dukes_1.1", "sheet": "{year}", "block": "Aggregate energy commodity balance", "row": ["Final consumption"], "column": "Electricity"},
                "dom": {"source": "dukes_1.1", "sheet": "{year}", "block": "Aggregate energy commodity balance", "row": ["Domestic"], "column": "Electricity"},
                "u": {"source": "qep_2.2.4", "sheet": "2.2.4", "block": "Table 2.2.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average variable unit price (£/kWh)"},
                "h": {"source": "ons_households", "sheet": "5", "block": "Number of households (thousands)", "row": ["All households"], "column": "{year} Estimate"},
                "f": {"source": "qep_2.2.4", "sheet": "2.2.4", "block": "Table 2.2.4", "row": ["{year}", "United Kingdom", "United Kingdom"], "column": "Overall: Average fixed cost (£/year)"},
                "n": {"source": "qep_3.4.1", "sheet": "3.4.1 (Annual excl CCL)", "block": "Table 3.4.1", "row": ["{year}"], "column": "Electricity: Average (Pence per kWh)"}
            },
            "formula": "(dom * 0.01163 * u + h * 1000 * f / 1e9) / 1.05 + (all - dom) * 0.01163 * n * 0.01"
        },
        "model": {
            "values": {"a": "total_cost.electricity_bn"},
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "Tests the retail layers in the cost to consumers. Household spend without 5% VAT, plus all other use at the average non-domestic price without VAT or Climate Change Levy."
    },
    "costs.electricity_ccl": {
        "group": "Costs",
        "label": "Climate Change Levy on non-domestic electricity",
        "units": "p/kWh",
        "observed": {
            "values": {
                "inc": {"source": "qep_3.4.1", "sheet": "3.4.2 (Annual inc CCL)", "block": "Table 3.4.2", "row": ["{year}"], "column": "Electricity: Average (Pence per kWh)"},
                "exc": {"source": "qep_3.4.1", "sheet": "3.4.1 (Annual excl CCL)", "block": "Table 3.4.1", "row": ["{year}"], "column": "Electricity: Average (Pence per kWh)"}
            },
            "formula": "inc - exc"
        },
        "model": {
            "values": {"a": "i.fossil_reference.non_domestic_electricity_ccl_p_kWh"},
            "formula": "a"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "Average levy paid, below the headline rate as some users have reliefs."
    },
    "costs.fossil_ref_tax": {
        "group": "Costs",
        "label": "Fossil reference, 2024 tax against this run",
        "units": "ratio",
        "observed": {
            "values": {"one": {"value": 1, "cite": "The stored 2024 tax should equal the tax in the live baseline run"}},
            "formula": "one"
        },
        "model": {
            "values": {
                "stored": "total_cost.tax_2024_bn",
                "live": "total_cost.tax_bn"
            },
            "formula": "stored / live"
        },
        "tolerance": 0.01,
        "basis": "input",
        "note": "The tax gap card compares scenarios with this stored figure, which includes fixed household electricity VAT."
    }
}
