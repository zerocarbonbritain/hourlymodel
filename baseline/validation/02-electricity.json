    "electricity.storage": {
        "group": "Electricity",
        "label": "Electricity storage output",
        "units": "TWh/yr",
        "observed": {
            "values": {
                "o": {"source": "dukes_5.16", "sheet": "5.16", "block": "Table 5.16.A Electricity output", "row": ["Total"], "column": "{year}"}
            },
            "formula": "o / 1000"
        },
        "model": {
            "values": {
                "a": "electric_storage.total_discharge"
            },
            "formula": "a / 10000"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "issue": "The optimal dispatch shaves backup peaks but does not arbitrage against prices, so storage cycles less than real storage (open-items.md, Model)."
    },
    "electricity.peak_demand": {
        "group": "Electricity",
        "label": "Peak electricity demand",
        "units": "GW",
        "observed": {
            "values": {
                "p": {"source": "dukes_5.10", "sheet": "5.10.A", "block": "Table 5.10.A", "row": ["Simultaneous maximum load met, MW", "Total"], "column": "{year}"}
            },
            "formula": "p / 1000"
        },
        "model": {
            "values": {
                "a": "balance.max_electricity_demand"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "End use demand grossed up for losses, highest hour in the ten weather years, against the 2024 simultaneous maximum load met. The model peak includes demand met by embedded generation and the coldest of ten winters, so it is expected to be higher.",
        "issue": "The model peak is higher than any year in DUKES 5.10 since 2010 (open-items.md, Model)."
    },
    "electricity.dispatchable_capacity": {
        "group": "Electricity",
        "label": "Dispatchable capacity",
        "units": "GW",
        "observed": {
            "values": {
                "fossil": {"source": "dukes_5.7", "sheet": "5.7", "block": "Table 5.7.A Capacity by fuel", "row": ["All generating companies", "Total fossil fuels capacity"], "column": "{year}"},
                "bio": {"source": "dukes_5.7", "sheet": "5.7", "block": "Table 5.7.A Capacity by fuel", "row": ["All generating companies", "Bioenergy and waste"], "column": "{year}"}
            },
            "formula": "(fossil + bio) / 1000"
        },
        "model": {
            "values": {
                "a": "electric_backup.max_capacity_requirement"
            },
            "formula": "a"
        },
        "tolerance": 0.25,
        "basis": "independent",
        "note": "The model sizes backup to the highest hourly need, with no reserve margin or outages, so it should be lower than installed capacity.",
        "issue": "Backup capacity, and its cost, is a third below the installed fleet, which also covers outages and a reserve margin (open-items.md, Model)."
    },
    "electricity.offshore_capacity": {
        "group": "Electricity",
        "label": "Offshore wind capacity",
        "units": "GW",
        "observed": {
            "values": {
                "f": {"source": "dukes_6.2", "sheet": "6.2", "block": "Installed Capacity (MW)", "row": ["Offshore Wind"], "column": "{year}"},
                "fl": {"source": "dukes_6.2", "sheet": "6.2", "block": "Installed Capacity (MW)", "row": ["Floating offshore wind"], "column": "{year}"}
            },
            "formula": "(f + fl) / 1000"
        },
        "model": {
            "values": {
                "a": "i.supply.offshore_wind_capacity"
            },
            "formula": "a"
        },
        "tolerance": 0.01,
        "basis": "input"
    },
