{
    "electricity.generation_total": {
        "group": "Electricity",
        "label": "UK electricity generation",
        "units": "TWh/yr",
        "observed": {
            "values": {
                "g": {"source": "dukes_5.6", "sheet": "5.6 Annual summaries", "block": "Table 5.6.J {year} summary", "row": ["All generating companies", "Generation"], "column": "Total All Sources (thermal and non-thermal)"}
            },
            "formula": "g / 1000"
        },
        "model": {
            "values": {
                "a": "balance.total_electricity_demand",
                "b": "supply.total_imports"
            },
            "formula": "(a - b) / 10000"
        },
        "tolerance": 0.03,
        "basis": "independent",
        "note": "All generating companies, including storage output. Modelled generation is total supply less imports.",
        "issue": "Storage output is low, see the storage check."
    },
    "electricity.net_imports": {
        "group": "Electricity",
        "label": "Net electricity imports",
        "units": "TWh/yr",
        "observed": {
            "values": {
                "imports": {"source": "dukes_1.1", "sheet": "{year}", "block": "Aggregate energy commodity balance", "row": ["Imports"], "column": "Electricity"},
                "exports": {"source": "dukes_1.1", "sheet": "{year}", "block": "Aggregate energy commodity balance", "row": ["Exports"], "column": "Electricity"}
            },
            "formula": "(imports + exports) * 0.01163"
        },
        "model": {
            "values": {
                "a": "supply.total_imports"
            },
            "formula": "a / 10000"
        },
        "tolerance": 0.01,
        "basis": "calibrated"
    },
    "electricity.wind": {
        "group": "Electricity",
        "label": "Wind generation",
        "units": "TWh/yr",
        "observed": {
            "values": {
                "g": {"source": "dukes_5.6", "sheet": "5.6 Annual summaries", "block": "Table 5.6.J {year} summary", "row": ["All generating companies", "Generation"], "column": "Wind (non thermal)"}
            },
            "formula": "g / 1000"
        },
        "model": {
            "values": {
                "a": "supply.total_offshore_wind",
                "b": "supply.total_onshore_wind"
            },
            "formula": "(a + b) / 10000"
        },
        "tolerance": 0.03,
        "basis": "calibrated"
    },
