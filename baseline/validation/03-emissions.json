{
    "emissions.total": {
        "group": "Emissions",
        "label": "Total emissions including international aviation and shipping",
        "units": "MtCO2e",
        "observed": {
            "values": {
                "t": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}"}}
            },
            "formula": "t"
        },
        "model": {
            "values": {
                "a": "emissions_balance.total",
                "b": "emissions_balance.aviation_co2e"
            },
            "formula": "a - b"
        },
        "tolerance": 0.03,
        "basis": "independent",
        "note": "Territorial plus international aviation and shipping. The model's aviation non CO2 uplift has no inventory counterpart and is left out. Non CO2 and process emissions are inputs, so this mainly tests fuel CO2 and the land sink."
    },
    "emissions.fuel_co2": {
        "group": "Emissions",
        "label": "Fuel combustion CO2",
        "units": "MtCO2",
        "observed": {
            "values": {
                "fuel": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel group": ["Gaseous fuels", "Petroleum", "Coal", "Other solid fuels"]}, "where_not": {"Territorial Emissions Statistics category": ["Sinter production", "Iron and steel production processes", "Iron and steel - coke production"]}},
                "waste": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel group": "Other emissions", "Territorial Emissions Statistics sector": "Electricity supply"}}
            },
            "formula": "fuel + waste"
        },
        "model": {
            "values": {
                "a": "emissions_balance.fossil_fuel_coal",
                "b": "emissions_balance.fossil_fuel_oil",
                "c": "emissions_balance.fossil_fuel_gas"
            },
            "formula": "a + b + c"
        },
        "tolerance": 0.03,
        "basis": "independent",
        "note": "CO2 from gaseous, petroleum and solid fuels including international bunkers, plus non biogenic waste burned for power, which the model includes in coal backup."
    },
    "emissions.gas_co2": {
        "group": "Emissions",
        "label": "Natural gas CO2",
        "units": "MtCO2",
        "observed": {
            "values": {
                "g": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel": "Natural Gas"}}
            },
            "formula": "g"
        },
        "model": {
            "values": {
                "a": "emissions_balance.fossil_fuel_gas"
            },
            "formula": "a"
        },
        "tolerance": 0.03,
        "basis": "independent"
    },
    "emissions.oil_co2": {
        "group": "Emissions",
        "label": "Oil CO2",
        "units": "MtCO2",
        "observed": {
            "values": {
                "p": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel group": "Petroleum"}},
                "lpg": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel": "Petroleum gases"}},
                "coke": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel": "Other solid fuels", "Territorial Emissions Statistics category": "Oil refineries"}}
            },
            "formula": "p + lpg + coke"
        },
        "model": {
            "values": {
                "a": "emissions_balance.fossil_fuel_oil"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "Petroleum including bunkers, plus LPG and refinery gases, which the inventory groups with gaseous fuels, and petroleum coke burned in refineries, which it groups with solid fuels."
    },
    "emissions.coal_co2": {
        "group": "Emissions",
        "label": "Coal, solid fuels and waste CO2",
        "units": "MtCO2",
        "observed": {
            "values": {
                "coal": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel": "Coal"}, "where_not": {"Territorial Emissions Statistics category": ["Sinter production", "Iron and steel production processes", "Iron and steel - coke production"]}},
                "solid": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel": "Other solid fuels"}, "where_not": {"Territorial Emissions Statistics category": ["Sinter production", "Iron and steel production processes", "Iron and steel - coke production"]}},
                "gases": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel": "Other gases"}, "where_not": {"Territorial Emissions Statistics category": ["Sinter production", "Iron and steel production processes", "Iron and steel - coke production"]}},
                "coke": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel": "Other solid fuels", "Territorial Emissions Statistics category": "Oil refineries"}},
                "waste": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel group": "Other emissions", "Territorial Emissions Statistics sector": "Electricity supply"}}
            },
            "formula": "coal + solid + gases + waste - coke"
        },
        "model": {
            "values": {
                "a": "emissions_balance.fossil_fuel_coal"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "Other gases are blast furnace and coke oven gas, made from coal. Petroleum coke in refineries is in the oil check, and sinter, process and coke production CO2 are inputs."
    },
    "emissions.electricity_co2": {
        "group": "Emissions",
        "label": "Electricity supply CO2",
        "units": "MtCO2",
        "observed": {
            "values": {
                "e": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Territorial Emissions Statistics sector": "Electricity supply"}}
            },
            "formula": "e"
        },
        "model": {
            "values": {
                "a": "grid_co2_emissions"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "Inventory power stations. Autogenerator emissions sit in industry in the inventory but are part of modelled backup."
    },
    "emissions.grid_intensity": {
        "group": "Emissions",
        "label": "Grid CO2 intensity, DUKES basis",
        "units": "gCO2/kWh",
        "observed": {
            "values": {
                "g": {"source": "dukes_5.14", "sheet": "5.14", "block": "Table 5.14", "row": ["All fuels (including nuclear and renewables)"], "column": "{year}"}
            },
            "formula": "g"
        },
        "model": {
            "values": {
                "co2": "grid_co2_emissions",
                "gen": "balance.total_electricity_demand",
                "imports": "supply.total_imports",
                "own_use": "i.energy_industry_use.electricity_own_use_prc"
            },
            "formula": "1000 * co2 / ((gen - imports) / 10000 * (1 - own_use / 100))"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "DUKES 5.14 divides generation CO2 by UK electricity supplied, excluding imports. The model's own grid intensity divides by total supply including imports."
    },
    "emissions.domestic_transport_co2": {
        "group": "Emissions",
        "label": "Domestic transport CO2",
        "units": "MtCO2",
        "observed": {
            "values": {
                "t": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Territorial Emissions Statistics sector": "Domestic transport"}}
            },
            "formula": "t"
        },
        "model": {
            "values": {
                "a": "emissions_balance.oil_by_use.road_rail_shipping"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "Road, rail and domestic shipping fossil fuel at the DESNZ diesel and petrol factors. Domestic aviation is in the aviation check."
    },
    "emissions.aviation_co2": {
        "group": "Emissions",
        "label": "Aviation CO2, domestic and international",
        "units": "MtCO2",
        "observed": {
            "values": {
                "a": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Fuel": "Aviation turbine fuel"}}
            },
            "formula": "a"
        },
        "model": {
            "values": {
                "a": "emissions_balance.oil_by_use.aviation"
            },
            "formula": "a"
        },
        "tolerance": 0.05,
        "basis": "independent",
        "note": "The model applies the average fossil share of liquid fuel to aviation, which overstates sustainable aviation fuel."
    },
    "emissions.shipping_co2": {
        "group": "Emissions",
        "label": "International shipping CO2",
        "units": "MtCO2",
        "observed": {
            "values": {
                "s": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "GHG grouped": "CO2", "Territorial Emissions Statistics category": "International shipping"}}
            },
            "formula": "s"
        },
        "model": {
            "values": {
                "a": "emissions_balance.oil_by_use.international_shipping"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "Marine bunker fuel from DUKES 1.1 at the marine gas oil factor.",
        "issue": "The inventory estimates international shipping bottom up from vessel activity, which gives less fuel than DUKES bunker sales. The baseline follows DUKES so the energy balance holds (open-items.md, Observed data)."
    },
    "emissions.forest_sink": {
        "group": "Emissions",
        "label": "Forest land carbon sink",
        "units": "MtCO2e",
        "observed": {
            "values": {
                "f": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "Territorial Emissions Statistics sector": "LULUCF", "CRT category": "4A*"}, "where_not": {"CRT category": ["*(III)*", "*(IV)*"]}}
            },
            "formula": "f"
        },
        "model": {
            "values": {
                "a": "emissions_balance.existing_woodland",
                "b": "emissions_balance.reforestation"
            },
            "formula": "a + b"
        },
        "tolerance": 0.02,
        "basis": "calibrated",
        "note": "Forest land carbon stock change and drainage, against existing woodland at its calibrated rate plus any new woodland."
    },
    "emissions.harvested_wood": {
        "group": "Emissions",
        "label": "Harvested wood products",
        "units": "MtCO2e",
        "observed": {
            "values": {
                "h": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "Territorial Emissions Statistics sector": "LULUCF", "CRT category": "4G*"}}
            },
            "formula": "h"
        },
        "model": {
            "values": {
                "a": "emissions_balance.harvested_wood"
            },
            "formula": "a"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "Timber from productive woodland at the ZCB harvest rates stored in wood products.",
        "issue": "The model credits 95% of harvested carbon as stored. The inventory reports the net change in the wood products pool, which subtracts the decay of older products (open-items.md, Model)."
    },
    "emissions.land_sink_total": {
        "group": "Emissions",
        "label": "Forest, harvested wood and biochar sink",
        "units": "MtCO2e",
        "observed": {
            "values": {
                "f": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "Territorial Emissions Statistics sector": "LULUCF", "CRT category": "4A*"}, "where_not": {"CRT category": ["*(III)*", "*(IV)*"]}},
                "h": {"source": "ghg_by_source", "sheet": "UK_by_source", "sum": "Emissions (MtCO2e)", "where": {"Year": "{year}", "Territorial Emissions Statistics sector": "LULUCF", "CRT category": "4G*"}}
            },
            "formula": "f + h"
        },
        "model": {
            "values": {
                "a": "emissions_balance.existing_woodland",
                "b": "emissions_balance.reforestation",
                "c": "emissions_balance.harvested_wood",
                "d": "emissions_balance.biochar_carbon_capture"
            },
            "formula": "a + b + c + d"
        },
        "tolerance": 0.1,
        "basis": "independent",
        "note": "The part of LULUCF left to the land use model."
    }
}
